    "The address stays the same. Patchy serves files from the new folder instead. Nothing is moved or deleted." : {
      "comment" : "Sheet message.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The address stays the same. Patchy serves files from the new folder instead. Nothing is moved or deleted." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يبقى العنوان كما هو. وسيقدّم Patchy الملفات من المجلد الجديد بدلًا من ذلك. لن يُنقل أو يُحذف أي شيء." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "L’adreça no canvia. Patchy passa a servir els arxius de la carpeta nova. No es mou ni s’elimina res." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Adresa zůstane stejná. Patchy bude místo toho poskytovat soubory z nové složky. Nic se nepřesune ani nesmaže." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Adressen forbliver den samme. Patchy viser i stedet arkiverne fra den nye mappe. Intet bliver flyttet eller slettet." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Die Adresse bleibt gleich. Patchy liefert stattdessen die Dateien aus dem neuen Ordner aus. Nichts wird bewegt oder gelöscht." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Η διεύθυνση μένει ίδια. Το Patchy προβάλλει πλέον τα αρχεία του νέου φακέλου. Τίποτα δεν μετακινείται ούτε διαγράφεται." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "La dirección no cambia. Patchy pasa a servir los archivos de la nueva carpeta. No se mueve ni se borra nada." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "نشانی همان می‌ماند. Patchy به‌جای آن، فایل‌ها را از پوشهٔ جدید ارائه می‌دهد. چیزی جابه‌جا یا پاک نمی‌شود." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Osoite pysyy samana. Patchy käyttää sen sijaan uuden kansion tiedostoja. Mitään ei siirretä eikä poisteta." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "L’adresse ne change pas. Patchy utilise désormais les fichiers du nouveau dossier. Rien n’est déplacé ni supprimé." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "הכתובת נשארת אותו הדבר. Patchy יציג במקום זאת את הקבצים מהתיקיה החדשה. שום דבר לא מועבר או נמחק." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Adresa ostaje ista. Patchy umjesto toga prikazuje datoteke iz nove mape. Ništa se ne premješta niti briše." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A cím ugyanaz marad. A Patchy ezentúl az új mappából szolgálja ki a fájlokat. Semmit nem helyez át és nem töröl." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Veffangið helst óbreytt. Patchy notar í staðinn skrárnar í nýju möppunni. Ekkert er flutt og engu er eytt." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "L’indirizzo resta lo stesso. Patchy usa invece i file della nuova cartella. Nulla viene spostato o eliminato." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "アドレスは変わりません。代わりに、Patchyが新しいフォルダのファイルを表示します。何も移動・削除されません。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "주소는 그대로입니다. Patchy가 대신 새 폴더의 파일을 제공합니다. 아무것도 이동하거나 삭제하지 않습니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Adressen forblir den samme. Patchy viser i stedet filer fra den nye mappen. Ingenting flyttes eller slettes." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Het adres blijft hetzelfde. Patchy gebruikt voortaan de bestanden uit de nieuwe map. Er wordt niets verplaatst of verwijderd." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Adressa blir den same. Patchy hentar filer frå den nye mappa i staden. Ingenting blir flytta eller sletta." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Adres pozostaje ten sam. Patchy udostępnia za to pliki z nowego folderu. Nic nie zostanie przeniesione ani usunięte." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "O endereço continua o mesmo. O Patchy passa a usar os arquivos da nova pasta. Nada é movido nem apagado." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "O endereço mantém-se. O Patchy passa a servir os ficheiros da nova pasta. Nada é movido nem apagado." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Adresa rămâne aceeași. Patchy folosește în schimb fișierele din dosarul nou. Nimic nu este mutat sau șters." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Адрес остаётся прежним. Patchy будет брать файлы из новой папки. Ничего не перемещается и не удаляется." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Adresa zostane rovnaká. Patchy bude namiesto toho používať súbory z nového priečinka. Nič sa nepresunie ani nevymaže." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Naslov ostane enak. Patchy bo namesto tega uporabljal datoteke iz nove mape. Nič se ne premakne ali izbriše." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Adressen förblir densamma. Patchy visar filerna från den nya mappen i stället. Inget flyttas eller raderas." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "ที่อยู่ยังคงเหมือนเดิม Patchy จะใช้ไฟล์จากโฟลเดอร์ใหม่แทน ไม่มีสิ่งใดถูกย้ายหรือลบ" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Adres aynı kalır. Patchy bundan sonra dosyaları yeni klasörden sunar. Hiçbir şey taşınmaz ya da silinmez." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Адреса не зміниться. Patchy просто використовуватиме файли з нової папки. Нічого не буде переміщено чи видалено." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Địa chỉ vẫn giữ nguyên. Patchy sẽ dùng các tệp trong thư mục mới thay vào đó. Không có gì bị di chuyển hay xóa." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "網址維持不變。Patchy會改為使用新資料夾中的檔案。不會移動或刪除任何內容。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "地址保持不变。Patchy 会改为提供新文件夹中的文件。不会移动或删除任何内容。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "網址維持不變，Patchy會改用新檔案夾中的檔案。不會搬移或刪除任何項目。" }
        }
      }
    },
