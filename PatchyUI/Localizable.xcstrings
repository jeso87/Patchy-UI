    "The server restarted, but it couldn’t update where your addresses point. Try Repair again." : {
      "comment" : "Message in an error sheet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The server restarted, but it couldn’t update where your addresses point. Try Repair again." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "أُعيد تشغيل الخادم، لكن تعذّر تحديث وجهة عناوينك. جرّب «إصلاح» مجددًا." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "El servidor s’ha reiniciat, però no ha pogut actualitzar cap a on apunten les teves adreces. Torna a provar “Repara”." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Server se restartoval, ale nepodařilo se upravit, kam vedou vaše adresy. Zkuste znovu „Opravit“." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Serveren blev genstartet, men kunne ikke opdatere, hvor dine adresser peger hen. Prøv “Reparer” igen." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Der Server wurde neu gestartet, konnte aber nicht aktualisieren, wohin deine Adressen zeigen. Versuche erneut „Reparieren“." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Ο διακομιστής επανεκκινήθηκε, αλλά δεν μπόρεσε να ενημερώσει πού οδηγούν οι διευθύνσεις σας. Δοκιμάστε ξανά την «Επιδιόρθωση»." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "El servidor se ha reiniciado, pero no ha podido actualizar adónde apuntan tus direcciones. Vuelve a probar “Reparar”." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "سرور مجدداً راه‌اندازی شد، اما نتوانست مسیر نشانی‌های شما را به‌روز کند. دوباره «تعمیر» را امتحان کنید." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Palvelin käynnistyi uudelleen, mutta se ei pystynyt päivittämään, minne osoitteesi ohjautuvat. Kokeile ”Korjaa” uudelleen." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Le serveur a redémarré, mais n’a pas pu mettre à jour la destination de vos adresses. Essayez de nouveau « Réparer »." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "השרת הופעל מחדש, אבל לא הצליח לעדכן לאן הכתובות שלך מפנות. יש לנסות שוב את ״תיקון״." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Poslužitelj je ponovno pokrenut, ali nije mogao ažurirati kamo su Vaše adrese usmjerene. Ponovno pokušajte “Popravi”." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A szerver újraindult, de nem tudta frissíteni, hová mutatnak a címei. Próbálja újra a „Javítás” gombbal." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Vefþjónninn endurræstist en gat ekki uppfært hvert vefföngin þín vísa. Prófaðu „Lagfæra“ aftur." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Il server si è riavviato, ma non è riuscito ad aggiornare i collegamenti dei tuoi indirizzi. Prova di nuovo “Ripara”." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "サーバは再起動しましたが、アドレスの行き先を更新できませんでした。もう一度「修復」を試してください。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "서버를 재시작했지만 주소가 가리키는 곳을 업데이트할 수 없었습니다. ‘복구’를 다시 시도하십시오." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Serveren startet på nytt, men kunne ikke oppdatere hvor adressene dine peker. Prøv «Reparer» igjen." }
        },
        "nl" : {
