    "Sites with a fixed web address, like WordPress, may send visitors to the local address instead." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Sites with a fixed web address, like WordPress, may send visitors to the local address instead." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "قد ترسل المواقع ذات العنوان الثابت، مثل WordPress، الزوار إلى العنوان المحلي بدلاً من ذلك." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Els llocs web amb una adreça fixa, com WordPress, poden enviar els visitants a l’adreça local." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Weby s pevnou webovou adresou, například WordPress, mohou návštěvníky přesměrovat na místní adresu." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Websteder med en fast webadresse, f.eks. WordPress, sender måske besøgende videre til den lokale adresse." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Websites mit fester Webadresse, etwa WordPress, leiten Besucher womöglich zur lokalen Adresse weiter." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Ιστότοποι με σταθερή διεύθυνση, όπως το WordPress, μπορεί να στέλνουν τους επισκέπτες στην τοπική διεύθυνση." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Los sitios con una dirección web fija, como WordPress, pueden enviar a los visitantes a la dirección local." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "سایت‌هایی با نشانی وب ثابت، مثل WordPress، ممکن است بازدیدکنندگان را به نشانی محلی بفرستند." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Sivustot, joilla on kiinteä verkko-osoite, kuten WordPress, voivat ohjata vierailijat paikalliseen osoitteeseen." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Les sites dont l’adresse web est fixe, comme WordPress, peuvent rediriger les visiteurs vers l’adresse locale." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "אתרים עם כתובת קבועה, כמו WordPress, עשויים לשלוח מבקרים לכתובת המקומית." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Web-stranice sa stalnom web-adresom, poput WordPressa, mogu posjetitelje preusmjeriti na lokalnu adresu." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Az állandó webcímű webhelyek, például a WordPress, a helyi címre irányíthatják a látogatókat." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Vefir með fast veffang, eins og WordPress, gætu sent gesti á staðbundna veffangið í staðinn." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "I siti con un indirizzo web fisso, come WordPress, potrebbero rimandare i visitatori all’indirizzo locale." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "WordPressのようにWebアドレスが固定されているサイトでは、訪問者がローカルアドレスに送られることがあります。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "WordPress처럼 웹 주소가 고정된 사이트는 방문자를 로컬 주소로 보낼 수 있습니다." }
