        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Dokler strežnik deluje, ta Mac prikazuje vašo lokalno kopijo in ne more doseči objavljenega spletnega mesta. Vsi drugi še vedno vidijo pravo." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Medan servern är igång visar den här Macen din lokala kopia och når inte webbplatsen på internet. Alla andra ser fortfarande den riktiga." }
