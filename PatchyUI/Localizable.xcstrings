        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Сертификаты обновлены. Если браузер всё ещё показывает предупреждение, завершите его и откройте снова." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Certifikáty sú obnovené. Ak prehliadač stále zobrazuje varovanie, ukončite ho a znova otvorte." }
