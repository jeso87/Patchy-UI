    "Use lowercase letters, numbers and hyphens, without a hyphen at the start or end." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Use lowercase letters, numbers and hyphens, without a hyphen at the start or end." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "استخدم أحرفًا لاتينية صغيرة وأرقامًا وشَرطات، دون شَرطة في البداية أو النهاية." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Fes servir lletres minúscules, números i guionets, sense cap guionet al principi ni al final." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Použijte malá písmena, číslice a spojovníky; spojovník nesmí být na začátku ani na konci." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Brug små bogstaver, tal og bindestreger, uden bindestreg i starten eller slutningen." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Verwende Kleinbuchstaben, Ziffern und Bindestriche, aber keinen Bindestrich am Anfang oder Ende." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Χρησιμοποιήστε πεζά γράμματα, αριθμούς και παύλες, χωρίς παύλα στην αρχή ή στο τέλος." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Usa letras minúsculas, números y guiones, sin guion al principio ni al final." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "از حروف کوچک لاتین، اعداد و خط تیره استفاده کنید، بدون خط تیره در ابتدا یا انتها." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Käytä pieniä kirjaimia, numeroita ja yhdysmerkkejä. Yhdysmerkki ei saa olla alussa eikä lopussa." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Utilisez des lettres minuscules, des chiffres et des traits d’union, sans trait d’union au début ni à la fin." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "יש להשתמש באותיות לטיניות קטנות, ספרות ומקפים, בלי מקף בהתחלה או בסוף." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Koristite mala slova, brojeve i crtice, bez crtice na početku ili kraju." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Használjon kisbetűket, számokat és kötőjeleket, de az elején vagy a végén ne legyen kötőjel." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Notaðu lágstafi, tölustafi og bandstrik, án bandstriks í upphafi eða lok." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Usa lettere minuscole, numeri e trattini, senza trattino all’inizio o alla fine." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "英小文字、数字、ハイフンを使ってください。先頭と末尾にはハイフンを使えません。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "영문 소문자, 숫자, 하이픈을 사용하되 하이픈으로 시작하거나 끝나지 않아야 합니다." }
