    "Patchy %@ is installed, but this Patchy UI was made for Patchy %@. Some things may not work until Patchy UI is updated to match." : {
      "comment" : "Banner. The placeholders are version numbers.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy %@ is installed, but this Patchy UI was made for Patchy %@. Some things may not work until Patchy UI is updated to match." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "‏Patchy %1$@ مثبّت، لكن Patchy UI هذا مصمَّم لـ Patchy %2$@. قد لا تعمل بعض الأشياء حتى يتم تحديث Patchy UI ليتوافق معه." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Hi ha instal·lat Patchy %1$@, però aquest Patchy UI es va fer per a Patchy %2$@. Pot ser que algunes coses no funcionin fins que s’actualitzi Patchy UI perquè hi coincideixi." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Je nainstalovaný Patchy %1$@, ale tato verze Patchy UI je určena pro Patchy %2$@. Některé věci nemusí fungovat, dokud se Patchy UI neaktualizuje." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy %1$@ er installeret, men denne Patchy UI blev lavet til Patchy %2$@. Noget virker måske ikke, før Patchy UI er opdateret, så de passer sammen." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy %1$@ ist installiert, aber dieses Patchy UI wurde für Patchy %2$@ gemacht. Manches funktioniert vielleicht erst, wenn Patchy UI passend aktualisiert ist." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Είναι εγκατεστημένο το Patchy %1$@, αλλά αυτό το Patchy UI φτιάχτηκε για το Patchy %2$@. Ορισμένα πράγματα ίσως να μη λειτουργούν μέχρι να ενημερωθεί αντίστοιχα το Patchy UI." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Está instalado Patchy %1$@, pero este Patchy UI se hizo para Patchy %2$@. Puede que algunas cosas no funcionen hasta que Patchy UI se actualice para coincidir." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "‏Patchy %1$@ نصب است، اما این Patchy UI برای Patchy %2$@ ساخته شده است. تا وقتی Patchy UI متناسب با آن به‌روز نشود، ممکن است برخی بخش‌ها کار نکنند." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy %1$@ on asennettu, mutta tämä Patchy UI on tehty Patchyn versiolle %2$@. Kaikki ei ehkä toimi, ennen kuin Patchy UI päivitetään vastaamaan sitä." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy %1$@ est installé, mais ce Patchy UI a été conçu pour Patchy %2$@. Certaines choses risquent de ne pas fonctionner tant que Patchy UI n’aura pas été mis à jour en conséquence." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "מותקן Patchy %1$@, אבל גרסת Patchy UI הזו נבנתה עבור Patchy %2$@. ייתכן שחלק מהדברים לא יעבדו עד ש-Patchy UI יעודכן בהתאם." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Instaliran je Patchy %1$@, ali ovaj Patchy UI izrađen je za Patchy %2$@. Neke stvari možda neće raditi dok se Patchy UI ne nadogradi da odgovara." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A Patchy %1$@ van telepítve, de ez a Patchy UI a Patchy %2$@ verzióhoz készült. Előfordulhat, hogy egyes funkciók nem működnek, amíg meg nem jelenik a Patchy UI hozzá illő frissítése." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy %1$@ er uppsett, en þetta Patchy UI var gert fyrir Patchy %2$@. Sumt virkar hugsanlega ekki fyrr en Patchy UI hefur verið uppfært til samræmis." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "È installato Patchy %1$@, ma questa versione di Patchy UI è stata creata per Patchy %2$@. Alcune funzioni potrebbero non andare finché Patchy UI non viene aggiornata di conseguenza." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy %1$@がインストールされていますが、このPatchy UIはPatchy %2$@用に作られています。Patchy UIが対応するバージョンにアップデートされるまで、一部の機能が動作しない可能性があります。" }
