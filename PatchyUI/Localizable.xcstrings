        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Sertifikata er fornya. Viss ein nettlesar framleis viser ei åtvaring, avslutt han og opne han på nytt." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Certyfikaty odświeżone. Jeśli przeglądarka nadal pokazuje ostrzeżenie, zakończ ją i otwórz ponownie." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Certificados renovados. Se algum navegador ainda mostrar um aviso, encerre o navegador e abra-o novamente." }
