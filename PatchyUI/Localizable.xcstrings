    "Another app is already using the ports this server needs (80 and 443). Quit it, then start the server again." : {
      "comment" : "Why the web server couldn't start.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Another app is already using the ports this server needs (80 and 443). Quit it, then start the server again." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يستخدم تطبيق آخر بالفعل المنافذ التي يحتاجها هذا الخادم (80 و443). أنهِه، ثم شغّل الخادم من جديد." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Una altra app ja fa servir els ports que necessita aquest servidor (80 i 443). Tanca-la i torna a iniciar el servidor." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Porty, které tento server potřebuje (80 a 443), už používá jiná aplikace. Ukončete ji a pak server spusťte znovu." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "En anden app bruger allerede de porte, som serveren skal bruge (80 og 443). Slut den, og start derefter serveren igen." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Ein anderes Programm belegt bereits die Ports, die dieser Server braucht (80 und 443). Beende es und starte den Server dann erneut." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Μια άλλη εφαρμογή χρησιμοποιεί ήδη τις θύρες που χρειάζεται αυτός ο διακομιστής (80 και 443). Τερματίστε την και έπειτα ξεκινήστε ξανά τον διακομιστή." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Otra app ya está usando los puertos que necesita este servidor (80 y 443). Sal de ella y vuelve a iniciar el servidor." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "برنامهٔ دیگری از قبل از پورت‌هایی که این سرور لازم دارد (80 و 443) استفاده می‌کند. از آن خارج شوید و سپس سرور را دوباره روشن کنید." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Jokin toinen appi käyttää jo portteja, joita tämä palvelin tarvitsee (80 ja 443). Lopeta se ja käynnistä palvelin sitten uudelleen." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Une autre app utilise déjà les ports dont ce serveur a besoin (80 et 443). Quittez-la, puis démarrez de nouveau le serveur." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "יישום אחר כבר משתמש ביציאות שהשרת הזה צריך (80 ו-443). יש לסיים אותו ואז להפעיל את השרת שוב." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Druga aplikacija već koristi priključke koji su potrebni ovom poslužitelju (80 i 443). Zatvorite je, a zatim ponovno pokrenite poslužitelj." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Egy másik app már használja a szerverhez szükséges portokat (80 és 443). Lépjen ki belőle, majd indítsa el ismét a szervert." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Annað forrit notar nú þegar gáttirnar sem þessi vefþjónn þarf (80 og 443). Hættu í því og ræstu svo vefþjóninn aftur." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Un’altra app sta già usando le porte di cui questo server ha bisogno (80 e 443). Chiudila, poi avvia di nuovo il server." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "ほかのアプリが、このサーバに必要なポート（80と443）をすでに使っています。そのアプリを終了してから、もう一度サーバを起動してください。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "다른 앱이 이 서버에 필요한 포트(80, 443)를 이미 사용하고 있습니다. 해당 앱을 종료한 다음 서버를 다시 시작하십시오." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Et annet program bruker allerede portene denne serveren trenger (80 og 443). Avslutt det, og start serveren på nytt." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Een andere app gebruikt al de poorten die deze server nodig heeft (80 en 443). Stop die app en start de server daarna opnieuw." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Ein annan app brukar alt portane som denne serveren treng (80 og 443). Avslutt appen, og start serveren på nytt." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Inny program już używa portów potrzebnych temu serwerowi (80 i 443). Zakończ go, a potem ponownie uruchom serwer." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Outro app já está usando as portas de que este servidor precisa (80 e 443). Encerre esse app e inicie o servidor novamente." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "Outra aplicação já está a usar as portas de que este servidor precisa (80 e 443). Saia dessa aplicação e volte a iniciar o servidor." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "O altă aplicație folosește deja porturile de care are nevoie acest server (80 și 443). Închideți-o, apoi porniți din nou serverul." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Другая программа уже занимает порты, нужные этому серверу (80 и 443). Завершите её, затем снова запустите сервер." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Porty, ktoré tento server potrebuje (80 a 443), už používa iná aplikácia. Ukončite ju a potom server spustite znova." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Druga aplikacija že uporablja vrata, ki jih ta strežnik potrebuje (80 in 443). Zaprite jo in nato znova zaženite strežnik." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Ett annat program använder redan portarna som den här servern behöver (80 och 443). Avsluta det och starta sedan servern igen." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "มีแอปอื่นกำลังใช้พอร์ตที่เซิร์ฟเวอร์นี้ต้องใช้อยู่ (80 และ 443) ออกจากแอปนั้น แล้วเริ่มเซิร์ฟเวอร์อีกครั้ง" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Başka bir uygulama bu sunucunun ihtiyaç duyduğu portları (80 ve 443) zaten kullanıyor. O uygulamadan çıkın, sonra sunucuyu tekrar başlatın." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Інша програма вже використовує порти, потрібні цьому серверу (80 і 443). Завершіть її, а потім запустіть сервер знову." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Một ứng dụng khác đang dùng các cổng mà máy chủ này cần (80 và 443). Hãy thoát ứng dụng đó, rồi khởi động lại máy chủ." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "另一個App已在使用這個伺服器需要的連接埠（80和443）。請結束該App，然後再次啟動伺服器。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "另一个 App 正在占用服务器所需的端口（80 和 443）。请退出该 App，然后重新启动服务器。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "另一個App已在使用這個伺服器需要的連接埠（80和443）。請結束該App，然後再次啟動伺服器。" }
        }
