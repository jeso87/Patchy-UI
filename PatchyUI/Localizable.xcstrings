      "comment" : "Shown when sharing a site failed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Couldn’t share this site. Show Details has the exact message from Patchy." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "تعذّرت مشاركة هذا الموقع. تجد في «إظهار التفاصيل» رسالة Patchy كما هي." }
        },
        "ca" : {
