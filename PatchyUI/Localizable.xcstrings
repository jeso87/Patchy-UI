        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Serwer uruchomił się ponownie, ale nie mógł zmienić, dokąd kierują twoje adresy. Spróbuj jeszcze raz użyć „Napraw”." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "O servidor reiniciou, mas não conseguiu atualizar para onde os seus endereços apontam. Tente Reparar novamente." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "O servidor reiniciou, mas não conseguiu atualizar para onde apontam os seus endereços. Experimente “Reparar” novamente." }
        },
        "ro" : {
