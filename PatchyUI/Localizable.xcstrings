    "Works from any app. Type part of a site’s name, then press Return to open it." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Works from any app. Type part of a site’s name, then press Return to open it." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يعمل من أي تطبيق. اكتب جزءًا من اسم الموقع، ثم اضغط على Return لفتحه." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Funciona des de qualsevol app. Escriu part del nom d’un lloc web i prem Retorn per obrir-lo." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Funguje z libovolné aplikace. Napište část názvu webu a stiskněte Return, web se otevře." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Virker fra alle apps. Skriv en del af et websteds navn, og tryk på Retur for at åbne det." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Funktioniert in jeder App. Gib einen Teil des Namens einer Website ein und drücke den Zeilenschalter, um sie zu öffnen." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Λειτουργεί από οποιαδήποτε εφαρμογή. Πληκτρολογήστε μέρος του ονόματος ενός ιστοτόπου και πατήστε Return για να ανοίξει." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Funciona desde cualquier app. Escribe parte del nombre de un sitio y pulsa Retorno para abrirlo." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "در هر برنامه‌ای کار می‌کند. بخشی از نام سایت را تایپ کنید و برای باز کردن آن Return را فشار دهید." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Toimii missä tahansa apissa. Kirjoita osa sivuston nimestä ja avaa se painamalla rivinvaihtonäppäintä." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Fonctionne depuis n’importe quelle app. Saisissez une partie du nom d’un site, puis appuyez sur Retour pour l’ouvrir." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "עובד מכל יישום. הקלידו חלק משם האתר ולחצו על Return כדי לפתוח אותו." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Radi iz bilo koje aplikacije. Upišite dio naziva web-stranice, zatim pritisnite Return da biste je otvorili." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Bármelyik appból működik. Írja be egy webhely nevének egy részét, majd nyomja meg a Return billentyűt a megnyitáshoz." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Virkar úr hvaða forriti sem er. Sláðu inn hluta af heiti vefs og ýttu á Return til að opna hann." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Funziona da qualsiasi app. Digita parte del nome di un sito, poi premi A capo per aprirlo." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "どのアプリからでも使えます。サイト名の一部を入力してReturnキーを押すと開きます。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "모든 앱에서 작동합니다. 사이트 이름의 일부를 입력한 다음 Return 키를 눌러 여십시오." }
        },
        "nb" : {
