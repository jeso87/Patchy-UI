        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Đã làm mới chứng chỉ. Nếu trình duyệt vẫn cảnh báo, hãy thoát rồi mở lại trình duyệt." }
        },
        "zh-HK" : {
