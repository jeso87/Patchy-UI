        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "รีเฟรชใบรับรองแล้ว หากเบราว์เซอร์ยังแสดงคำเตือน ให้ออกจากเบราว์เซอร์แล้วเปิดใหม่" }
