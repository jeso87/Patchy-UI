    "Disconnected %@. Share now makes public links on trycloudflare.com." : {
      "comment" : "Banner under the toolbar. The placeholder is a domain like example.com.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Disconnected %@. Share now makes public links on trycloudflare.com." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "تم فصل %@. تُنشئ «مشاركة» الآن روابط عامة على trycloudflare.com." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "S’ha desconnectat %@. Ara Comparteix crea enllaços públics a trycloudflare.com." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Doména %@ je odpojená. Tlačítko „Sdílet“ teď vytváří veřejné odkazy na trycloudflare.com." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Forbindelsen til %@ er afbrudt. Del laver nu offentlige links på trycloudflare.com." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ wurde getrennt. „Teilen“ erstellt jetzt öffentliche Links auf trycloudflare.com." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Το %@ αποσυνδέθηκε. Η «Κοινή χρήση» δημιουργεί πλέον δημόσιους συνδέσμους στο trycloudflare.com." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Se ha desconectado %@. Ahora “Compartir” crea enlaces públicos en trycloudflare.com." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "اتصال %@ قطع شد. اکنون «اشتراک‌گذاری» پیوندهای عمومی در trycloudflare.com می‌سازد." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Verkkotunnus %@ irrotettiin. ”Jaa” luo nyt julkisia linkkejä osoitteeseen trycloudflare.com." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ a été déconnecté. « Partager » crée désormais des liens publics sur trycloudflare.com." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "הדומיין %@ נותק. מעכשיו ״שיתוף״ יוצר קישורים ציבוריים ב-trycloudflare.com." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Domena %@ je odspojena. “Podijeli” sada stvara javne poveznice na trycloudflare.com." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ leválasztva. A „Megosztás” mostantól nyilvános linkeket készít a trycloudflare.com-on." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ var aftengt. „Deila“ býr nú til opinbera tengla á trycloudflare.com." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ è stato scollegato. Ora “Condividi” crea link pubblici su trycloudflare.com." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "%@の接続を解除しました。これからは、共有するとtrycloudflare.comの公開リンクが作成されます。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ 연결을 해제했습니다. 이제 공유하면 trycloudflare.com 공개 링크가 만들어집니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ er koblet fra. «Del» lager nå offentlige lenker på trycloudflare.com." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ is ontkoppeld. Deel maakt nu openbare links op trycloudflare.com." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ er kopla frå. «Del» lagar no offentlege lenkjer på trycloudflare.com." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Odłączono domenę %@. Przycisk „Udostępnij” tworzy teraz linki publiczne w trycloudflare.com." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ foi desconectado. Agora, Compartilhar cria links públicos no trycloudflare.com." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ foi desligado. Agora, Partilhar cria ligações públicas em trycloudflare.com." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ a fost deconectat. Acum, Partajați creează linkuri publice pe trycloudflare.com." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Домен %@ отключён. Теперь «Поделиться» создаёт публичные ссылки на trycloudflare.com." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Doména %@ je odpojená. Tlačidlo „Zdieľať“ teraz vytvára verejné odkazy na trycloudflare.com." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Domena %@ je odklopljena. »Deli« zdaj ustvarja javne povezave na trycloudflare.com." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ har kopplats från. Dela skapar nu offentliga länkar på trycloudflare.com." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "ยกเลิกการเชื่อมต่อ %@ แล้ว ตอนนี้การแชร์จะสร้างลิงก์สาธารณะบน trycloudflare.com" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ bağlantısı kesildi. “Paylaş” artık trycloudflare.com üzerinde herkese açık bağlantılar oluşturuyor." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Домен %@ від’єднано. Тепер «Поділитися» створює публічні посилання на trycloudflare.com." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Đã ngắt kết nối %@. Giờ đây Chia sẻ sẽ tạo liên kết công khai trên trycloudflare.com." }
        },
        "zh-HK" : {
