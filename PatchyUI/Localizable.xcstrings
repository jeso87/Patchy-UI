    "Patchy can update your addresses without asking each time." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy can update your addresses without asking each time." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يمكن لـ Patchy تحديث عناوينك دون أن يسألك في كل مرة." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy pot actualitzar les teves adreces sense preguntar cada vegada." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy může upravovat vaše adresy, aniž by se pokaždé ptal." }
        },
        "da" : {
