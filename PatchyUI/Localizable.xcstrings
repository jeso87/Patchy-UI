    "%@ is a real web address. While the server runs, this Mac opens your local copy and can’t reach the live website. Stop the server to see the live site again." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ is a real web address. While the server runs, this Mac opens your local copy and can’t reach the live website. Stop the server to see the live site again." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "‏%@ عنوان ويب حقيقي. ما دام الخادم يعمل، يفتح جهاز Mac هذا نسختك المحلية ولا يمكنه الوصول إلى الموقع الفعلي. أوقِف الخادم لترى الموقع الفعلي من جديد." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ és una adreça web real. Mentre el servidor està en marxa, aquest Mac obre la teva còpia local i no pot accedir al lloc web en línia. Atura el servidor per tornar a veure el lloc web en línia." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ je skutečná webová adresa. Dokud server běží, tento Mac otevírá vaši místní kopii a na skutečný web se nedostane. Chcete-li skutečný web znovu vidět, zastavte server." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ er en rigtig webadresse. Mens serveren kører, åbner denne Mac din lokale kopi og kan ikke nå det rigtige websted. Stop serveren for at se det rigtige websted igen." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ ist eine echte Webadresse. Solange der Server läuft, öffnet dieser Mac deine lokale Kopie und erreicht die Live-Website nicht. Stoppe den Server, um die Live-Website wieder zu sehen." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Το %@ είναι πραγματική διεύθυνση ιστού. Όσο λειτουργεί ο διακομιστής, αυτό το Mac ανοίγει το τοπικό σας αντίγραφο και δεν μπορεί να φτάσει στον πραγματικό ιστότοπο. Σταματήστε τον διακομιστή για να δείτε ξανά τον πραγματικό ιστότοπο." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ es una dirección web real. Mientras el servidor esté en marcha, este Mac abre tu copia local y no puede llegar al sitio web real. Detén el servidor para volver a ver el sitio real." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "‏%@ یک نشانی وب واقعی است. تا وقتی سرور در حال اجراست، این Mac نسخهٔ محلی شما را باز می‌کند و به سایت آنلاین دسترسی ندارد. برای دیدن دوبارهٔ سایت آنلاین، سرور را خاموش کنید." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ on oikea verkko-osoite. Kun palvelin on käynnissä, tämä Mac avaa paikallisen kopiosi eikä tavoita verkossa olevaa sivustoa. Pysäytä palvelin, niin näet verkossa olevan sivuston taas." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ est une adresse web réelle. Tant que le serveur est en marche, ce Mac ouvre votre copie locale et ne peut pas accéder au site en ligne. Arrêtez le serveur pour revoir le site en ligne." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "הכתובת %@ היא כתובת אינטרנט אמיתית. כל עוד השרת פועל, ה-Mac הזה פותח את העותק המקומי שלך ולא יכול להגיע לאתר החי. כדי לראות שוב את האתר החי, יש לעצור את השרת." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ je stvarna web-adresa. Dok poslužitelj radi, ovaj Mac otvara Vašu lokalnu kopiju i ne može doći do web-stranice na internetu. Zaustavite poslužitelj i ponovno ćete vidjeti web-stranicu na internetu." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A(z) %@ valódi webcím. Amíg a szerver fut, ez a Mac a helyi másolatot nyitja meg, és nem éri el az élő webhelyet. Állítsa le a szervert, hogy ismét az élő webhelyet lássa." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ er raunverulegt veffang. Á meðan vefþjónninn keyrir opnar þessi Mac afritið þitt á tölvunni og nær ekki í vefinn á netinu. Stöðvaðu vefþjóninn til að sjá vefinn á netinu aftur." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ è un indirizzo web reale. Finché il server è attivo, questo Mac apre la tua copia locale e non raggiunge il sito online. Ferma il server per rivedere il sito online." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "%@は実在するWebアドレスです。サーバの実行中、このMacではローカルのコピーが開き、実際のWebサイトにはアクセスできません。実際のサイトをもう一度見るには、サーバを停止してください。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ 주소는 실제 웹 주소입니다. 서버가 실행 중인 동안 이 Mac에서는 로컬 사본이 열리며 실제 사이트에 접속할 수 없습니다. 실제 사이트를 다시 보려면 서버를 중지하십시오." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ er en ekte nettadresse. Mens serveren kjører, åpner denne Macen den lokale kopien din og når ikke det ekte nettstedet. Stopp serveren for å se det ekte nettstedet igjen." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ is een echt webadres. Zolang de server draait, opent deze Mac je lokale kopie en kan hij de live website niet bereiken. Stop de server om de live website weer te zien." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ er ei ekte nettadresse. Medan serveren køyrer, opnar denne Macen den lokale kopien din og når ikkje den ekte nettstaden. Stopp serveren for å sjå den ekte nettstaden igjen." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ to prawdziwy adres internetowy. Gdy serwer działa, ten Mac otwiera twoją lokalną kopię i nie może dotrzeć do witryny w internecie. Zatrzymaj serwer, aby znów zobaczyć witrynę w internecie." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ é um endereço web real. Enquanto o servidor estiver em execução, este Mac abre a sua cópia local e não consegue acessar o site na internet. Pare o servidor para ver o site na internet novamente." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ é um endereço web real. Enquanto o servidor estiver a funcionar, este Mac abre a sua cópia local e não consegue chegar ao site real. Pare o servidor para voltar a ver o site real." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ este o adresă web reală. Cât timp serverul rulează, acest Mac deschide copia dvs. locală și nu poate ajunge la site-ul de pe internet. Opriți serverul ca să vedeți din nou site-ul de pe internet." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ — настоящий веб-адрес. Пока сервер работает, этот Mac открывает вашу локальную копию и не может попасть на сайт в интернете. Остановите сервер, чтобы снова увидеть сайт в интернете." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ je skutočná webová adresa. Kým server beží, tento Mac otvára vašu lokálnu kópiu a skutočný web nedosiahne. Ak chcete skutočný web znova vidieť, zastavte server." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ je pravi spletni naslov. Dokler strežnik deluje, ta Mac odpira vašo lokalno kopijo in ne more doseči objavljenega spletnega mesta. Ustavite strežnik, če želite znova videti objavljeno spletno mesto." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ är en riktig webbadress. Medan servern är igång öppnar den här Macen din lokala kopia och når inte webbplatsen på internet. Stoppa servern för att se webbplatsen på internet igen." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ เป็นที่อยู่เว็บจริง ขณะที่เซิร์ฟเวอร์ทำงาน Mac เครื่องนี้จะเปิดสำเนาในเครื่องของคุณและไปยังเว็บไซต์จริงไม่ได้ หยุดเซิร์ฟเวอร์เพื่อดูเว็บไซต์จริงอีกครั้ง" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ gerçek bir web adresi. Sunucu çalışırken bu Mac yerel kopyanızı açar ve canlı siteye ulaşamaz. Canlı siteyi yeniden görmek için sunucuyu durdurun." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ — це справжня вебадреса. Поки сервер працює, цей Mac відкриває вашу локальну копію і не може дістатися справжнього сайту. Зупиніть сервер, щоб знову бачити справжній сайт." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ là một địa chỉ web thật. Khi máy chủ đang chạy, máy Mac này mở bản sao cục bộ của bạn và không thể vào trang web thật. Hãy dừng máy chủ để xem lại trang web thật." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "%@是真實網址。伺服器運行期間，這部Mac會開啟你的本機副本，無法連到真實網站。停止伺服器就可以再次看到真實網站。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ 是真实网址。服务器运行期间，这台 Mac 会打开你的本地副本，无法访问线上网站。停止服务器即可再次看到线上网站。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "%@是真實網址。伺服器執行時，這台Mac會打開你的本機副本，無法連到線上網站。停止伺服器即可再次看到線上網站。" }
        }
      }
    },
