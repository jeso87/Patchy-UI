    "Your sites won’t open until it’s running. Show Details has the exact message from Patchy." : {
      "comment" : "Message in an error sheet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Your sites won’t open until it’s running. Show Details has the exact message from Patchy." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "لن تُفتح مواقعك حتى يعمل الخادم. تجد في «إظهار التفاصيل» رسالة Patchy كما هي." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Els teus llocs web no s’obriran fins que estigui en marxa. A “Mostra els detalls” hi ha el missatge exacte de Patchy." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Vaše weby se neotevřou, dokud server nepoběží. Přesnou zprávu od Patchy najdete pod „Zobrazit podrobnosti“." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Dine websteder åbner ikke, før den kører. Under “Vis oplysninger” står den præcise meddelelse fra Patchy." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Deine Websites öffnen sich erst, wenn er läuft. Unter „Details einblenden“ steht die genaue Meldung von Patchy." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Οι ιστότοποί σας δεν θα ανοίγουν μέχρι να λειτουργήσει. Η «Εμφάνιση λεπτομερειών» περιέχει το ακριβές μήνυμα του Patchy." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Tus sitios no se abrirán hasta que esté en marcha. En “Mostrar detalles” está el mensaje exacto de Patchy." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "تا وقتی سرور در حال اجرا نباشد، سایت‌های شما باز نمی‌شوند. پیام دقیق Patchy در «نمایش جزئیات» است." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Sivustosi eivät avaudu, ennen kuin se on käynnissä. Patchyn tarkka viesti löytyy kohdasta ”Näytä tiedot”." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Vos sites ne s’ouvriront pas tant qu’il ne sera pas en marche. « Afficher les détails » contient le message exact de Patchy." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "האתרים שלך לא ייפתחו עד שהשרת יפעל. ב״הצגת פרטים״ מופיעה ההודעה המדויקת מ-Patchy." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Vaše web-stranice neće se otvarati dok ne proradi. Pod “Prikaži detalje” nalazi se točna poruka od Patchyja." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A webhelyei addig nem nyílnak meg, amíg a szerver nem fut. A Patchy pontos üzenete a „Részletek megjelenítése” alatt látható." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Vefirnir þínir opnast ekki fyrr en hann er kominn í gang. Undir „Sýna upplýsingar“ eru nákvæm skilaboð frá Patchy." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "I tuoi siti non si aprono finché non è attivo. In “Mostra dettagli” trovi il messaggio esatto di Patchy." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "サーバが実行されるまでサイトは開けません。Patchyからの正確なメッセージは「詳細を表示」で確認できます。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "서버가 실행될 때까지 사이트가 열리지 않습니다. Patchy가 보낸 정확한 메시지는 ‘세부사항 보기’에 있습니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Nettstedene dine åpnes ikke før den kjører. Under «Vis detaljer» finner du den nøyaktige meldingen fra Patchy." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Je websites openen pas als hij draait. Bij 'Toon details' staat de precieze melding van Patchy." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Nettstadene dine kan ikkje opnast før serveren køyrer. Under «Vis detaljar» finn du den nøyaktige meldinga frå Patchy." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Twoje witryny nie otworzą się, dopóki serwer nie zacznie działać. W „Pokaż szczegóły” znajdziesz dokładny komunikat od Patchy." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Os seus sites não vão abrir enquanto ele não estiver em execução. A mensagem exata do Patchy está em Mostrar Detalhes." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "Os seus sites não abrem enquanto não estiver a funcionar. Em “Mostrar detalhes” encontra a mensagem exata do Patchy." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Site-urile dvs. nu se vor deschide până nu pornește. „Afișați detaliile” conține mesajul exact de la Patchy." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Ваши сайты не откроются, пока он не заработает. Нажмите «Показать подробности», чтобы увидеть точное сообщение Patchy." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Vaše weby sa neotvoria, kým server nebude bežať. Presné hlásenie od Patchy nájdete v časti „Zobraziť podrobnosti“." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Vaša spletna mesta se ne bodo odprla, dokler strežnik ne bo deloval. Pod »Prikaži podrobnosti« je natančno sporočilo programa Patchy." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Dina webbplatser öppnas inte förrän den är igång. Under ”Visa detaljer” finns det exakta meddelandet från Patchy." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "เว็บไซต์ของคุณจะเปิดไม่ได้จนกว่าเซิร์ฟเวอร์จะทำงาน ดูข้อความที่ตรงตามจริงจาก Patchy ได้ที่ “แสดงรายละเอียด”" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Sunucu çalışana kadar siteleriniz açılmaz. Patchy’nin tam iletisi “Ayrıntıları Göster”de." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Ваші сайти не відкриватимуться, доки він не запрацює. Натисніть «Показати деталі», щоб побачити точне повідомлення Patchy." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Các trang web của bạn sẽ không mở được cho đến khi máy chủ chạy. “Hiển thị chi tiết” có thông báo chính xác từ Patchy." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "伺服器運行之前，你的網站無法開啟。「顯示詳情」中有Patchy的原始訊息。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "服务器运行之前，你的网站将无法打开。“显示详情”中有来自 Patchy 的确切信息。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "伺服器執行之前，你的網站都無法打開。「顯示詳細資訊」中有Patchy的完整訊息。" }
        }
      }
    },
