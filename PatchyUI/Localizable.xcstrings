          "stringUnit" : { "state" : "translated", "value" : "Zertifikate erneuert. Wenn ein Browser noch eine Warnung zeigt, beende ihn und öffne ihn erneut." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Τα πιστοποιητικά ανανεώθηκαν. Αν ένα πρόγραμμα περιήγησης εξακολουθεί να δείχνει προειδοποίηση, τερματίστε το και ανοίξτε το ξανά." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Certificados renovados. Si un navegador sigue mostrando un aviso, sal de él y vuelve a abrirlo." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "گواهی‌ها تازه شدند. اگر مرورگری هنوز هشدار نشان می‌دهد، از آن خارج شوید و دوباره بازش کنید." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Varmenteet uusittu. Jos selain näyttää yhä varoituksen, lopeta se ja avaa se uudelleen." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Certificats renouvelés. Si un navigateur affiche encore un avertissement, quittez-le et rouvrez-le." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "האישורים חודשו. אם דפדפן עדיין מציג אזהרה, יש לסיים אותו ולפתוח אותו מחדש." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Certifikati su obnovljeni. Ako preglednik i dalje prikazuje upozorenje, zatvorite ga i ponovno otvorite." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A tanúsítványok frissítve. Ha egy böngésző még mindig figyelmeztetést mutat, lépjen ki belőle, és nyissa meg újra." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Skilríkin voru endurnýjuð. Ef vafri sýnir enn viðvörun skaltu hætta í honum og opna hann aftur." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Certificati rinnovati. Se un browser mostra ancora un avviso, chiudilo e riaprilo." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "証明書を更新しました。ブラウザにまだ警告が表示される場合は、ブラウザを終了して開き直してください。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "인증서를 갱신했습니다. 브라우저에 여전히 경고가 표시되면 브라우저를 종료했다가 다시 여십시오." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Sertifikatene er fornyet. Hvis en nettleser fortsatt viser en advarsel, avslutter du den og åpner den igjen." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Certificaten vernieuwd. Toont een browser nog een waarschuwing, stop de browser dan en open hem opnieuw." }
