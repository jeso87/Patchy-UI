        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Palvelinta pyörittävä taustapalvelu ei vastannut. Sen pysäyttäminen ja uudelleenkäynnistäminen palauttaa sen ennalleen." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Le service d’arrière-plan qui fait tourner le serveur n’a pas répondu. L’arrêter puis le redémarrer le réinitialise." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "השירות ברקע שמפעיל את השרת לא הגיב. עצירה והפעלה מחדש שלו יאפסו אותו." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Pozadinska usluga koja pokreće poslužitelj nije odgovorila. Zaustavljanje i ponovno pokretanje vraća je u početno stanje." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A szervert futtató háttérszolgáltatás nem válaszolt. Ha leállítja, majd ismét elindítja, alaphelyzetbe áll." }
