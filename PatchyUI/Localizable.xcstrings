        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Επιλέξτε το όνομα πριν από το %@. Το Patchy το θυμάται, ώστε αυτός ο ιστότοπος να μοιράζεται κάθε φορά στην ίδια διεύθυνση." }
        },
        "es" : {
