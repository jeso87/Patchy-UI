    "A group keeps related sites together in the sidebar and the menu bar, such as one customer’s sites. It doesn’t change the sites themselves." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "A group keeps related sites together in the sidebar and the menu bar, such as one customer’s sites. It doesn’t change the sites themselves." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "تجمع المجموعة المواقع المترابطة معًا في الشريط الجانبي وشريط القائمة، مثل مواقع عميل واحد. ولا تغيّر المواقع نفسها." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Un grup manté junts els llocs web relacionats a la barra lateral i a la barra de menús, com ara els llocs web d’un mateix client. No canvia els llocs web en si." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Skupina drží související weby pohromadě v bočním panelu a na řádku nabídek, třeba weby jednoho zákazníka. Na samotných webech nic nemění." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "En gruppe samler websteder, der hører sammen, i indholdsoversigten og på menulinjen, f.eks. én kundes websteder. Den ændrer ikke selve webstederne." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Eine Gruppe hält zusammengehörige Websites in der Seitenleiste und in der Menüleiste beisammen, etwa die Websites eines Kunden. An den Websites selbst ändert sie nichts." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Μια ομάδα κρατά μαζί σχετικούς ιστότοπους στην πλαϊνή στήλη και στη γραμμή μενού, για παράδειγμα τους ιστότοπους ενός πελάτη. Δεν αλλάζει τους ίδιους τους ιστότοπους." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Un grupo reúne sitios relacionados en la barra lateral y en la barra de menús, por ejemplo los sitios de un mismo cliente. No cambia nada de los propios sitios." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "گروه، سایت‌های مرتبط را در نوار کناری و نوار منو کنار هم نگه می‌دارد، مثلاً سایت‌های یک مشتری. خود سایت‌ها را تغییر نمی‌دهد." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Ryhmä pitää toisiinsa liittyvät sivustot yhdessä sivupalkissa ja valikkorivillä, esimerkiksi yhden asiakkaan sivustot. Se ei muuta itse sivustoja." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Un groupe réunit des sites liés dans la barre latérale et dans la barre des menus, par exemple les sites d’un même client. Il ne modifie pas les sites eux-mêmes." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "קבוצה מרכזת אתרים קשורים בסרגל הצד ובשורת התפריטים, למשל האתרים של לקוח אחד. היא לא משנה את האתרים עצמם." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Grupa drži povezane web-stranice zajedno u rubnom stupcu i na traci izbornika, primjerice web-stranice jednog klijenta. Same web-stranice ne mijenja." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A csoport együtt tartja az összetartozó webhelyeket az oldalsávban és a menüsorban, például egy ügyfél webhelyeit. Magukat a webhelyeket nem módosítja." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Hópur heldur skyldum vefjum saman í hliðarstikunni og valmyndastikunni, til dæmis vefjum eins viðskiptavinar. Hann breytir ekki vefjunum sjálfum." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Un gruppo tiene insieme i siti correlati nella barra laterale e nella barra dei menu, per esempio i siti di uno stesso cliente. Non modifica i siti stessi." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "グループを使うと、1人の顧客のサイトなど、関連するサイトをサイドバーとメニューバーでまとめておけます。サイトそのものは変わりません。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "그룹은 한 고객의 사이트처럼 관련된 사이트를 사이드바와 메뉴 막대에 함께 모아 둡니다. 사이트 자체는 변경하지 않습니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "En gruppe holder nettsteder som hører sammen, samlet i sidepanelet og menylinjen, for eksempel nettstedene til én kunde. Den endrer ikke selve nettstedene." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Een groep houdt websites die bij elkaar horen samen in de navigatiekolom en de menubalk, zoals de websites van één klant. Aan de websites zelf verandert niets." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Ei gruppe held saman nettstader som høyrer saman, i sidepanelet og på menylinja, til dømes nettstadene til éin kunde. Ho endrar ikkje sjølve nettstadene." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Grupa trzyma razem powiązane witryny na pasku bocznym i na pasku menu, np. witryny jednego klienta. Nie zmienia samych witryn." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Um grupo reúne sites relacionados na barra lateral e na barra de menus, como os sites de um mesmo cliente. Ele não altera os sites em si." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "Um grupo junta sites relacionados na barra lateral e na barra de menus, como os sites de um mesmo cliente. Não altera os próprios sites." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Un grup ține împreună site-urile înrudite în bara laterală și în bara de meniu, de exemplu site-urile unui client. Nu modifică site-urile în sine." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Группа держит связанные сайты вместе в боковом меню и в строке меню — например, сайты одного клиента. Сами сайты при этом не меняются." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Skupina drží súvisiace weby pohromade v postrannom paneli a v lište, napríklad weby jedného zákazníka. Samotné weby nijako nemení." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Skupina drži povezana spletna mesta skupaj v stranski vrstici in menijski vrstici, na primer spletna mesta ene stranke. Samih spletnih mest ne spreminja." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "En grupp samlar webbplatser som hör ihop i sidofältet och menyraden, till exempel en kunds webbplatser. Själva webbplatserna ändras inte." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "กลุ่มช่วยรวมเว็บไซต์ที่เกี่ยวข้องกันไว้ด้วยกันในแถบด้านข้างและแถบเมนู เช่น เว็บไซต์ของลูกค้ารายหนึ่ง โดยไม่เปลี่ยนแปลงตัวเว็บไซต์" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Grup, örneğin bir müşterinin siteleri gibi ilişkili siteleri kenar çubuğunda ve menü çubuğunda bir arada tutar. Sitelerin kendisini değiştirmez." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Група тримає повʼязані сайти разом на бічній панелі та в рядку меню — наприклад, сайти одного клієнта. Самі сайти вона не змінює." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Nhóm giữ các trang web liên quan ở cùng một chỗ trong thanh bên và thanh menu, ví dụ các trang web của cùng một khách hàng. Nhóm không thay đổi bản thân các trang web." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "群組可以將相關的網站集中放在側邊欄和選單列中，例如同一位客戶的網站。群組不會改動網站本身。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "分组会把相关的网站集中显示在边栏和菜单栏中，例如同一位客户的网站。它不会改变网站本身。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "群組會將相關的網站集中在側邊欄和選單列中，例如同一位客戶的網站。它不會更動網站本身。" }
        }
      }
    },
    "Add Site" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Add Site" }
