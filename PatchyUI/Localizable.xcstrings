    "Choose the name before %@. Patchy remembers it, so this site is shared at the same address every time." : {
      "comment" : "Sheet message. The placeholder is a domain like example.com.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Choose the name before %@. Patchy remembers it, so this site is shared at the same address every time." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "اختر الاسم الذي يسبق %@. يتذكّره Patchy، لذا يُشارَك هذا الموقع على العنوان نفسه في كل مرة." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Tria el nom que va davant de %@. Patchy el recorda, així que aquest lloc web es comparteix sempre a la mateixa adreça." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Vyberte název, který stojí před %@. Patchy si ho zapamatuje, takže se tento web bude pokaždé sdílet na stejné adrese." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Vælg navnet foran %@. Patchy husker det, så dette websted altid deles på den samme adresse." }
