    "The menu bar item stays either way. With the Dock icon off, open the window from the menu bar item." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The menu bar item stays either way. With the Dock icon off, open the window from the menu bar item." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يبقى عنصر شريط القائمة في الحالتين. عند إخفاء أيقونة Dock، افتح النافذة من عنصر شريط القائمة." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "La icona de la barra de menús hi és igualment. Sense la icona al Dock, obre la finestra des de la barra de menús." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Položka na řádku nabídek zůstane v každém případě. Když je ikona v Docku vypnutá, otevřete okno z položky na řádku nabídek." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Symbolet på menulinjen bliver under alle omstændigheder. Uden symbol i Dock åbner du vinduet fra symbolet på menulinjen." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Das Symbol in der Menüleiste bleibt in jedem Fall. Ohne Dock-Symbol öffnest du das Fenster über die Menüleiste." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Το στοιχείο στη γραμμή μενού παραμένει σε κάθε περίπτωση. Χωρίς εικονίδιο στο Dock, ανοίξτε το παράθυρο από το στοιχείο της γραμμής μενού." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "El icono de la barra de menús se queda en cualquier caso. Sin el icono en el Dock, abre la ventana desde la barra de menús." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "نماد نوار منو در هر صورت باقی می‌ماند. وقتی نماد Dock خاموش است، پنجره را از نماد نوار منو باز کنید." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Valikkorivin kohde pysyy joka tapauksessa. Kun Dock-symboli ei ole käytössä, avaa ikkuna valikkorivin kohteesta." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "L’icône de la barre des menus reste dans tous les cas. Sans icône dans le Dock, ouvrez la fenêtre depuis l’icône de la barre des menus." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "הפריט בשורת התפריטים נשאר בכל מקרה. כשהצלמית ב-Dock כבויה, אפשר לפתוח את החלון מהפריט בשורת התפריטים." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Stavka na traci izbornika ostaje u svakom slučaju. Kad je ikona u Docku isključena, otvorite prozor preko stavke na traci izbornika." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A menüsor-ikon mindenképp megmarad. Ha a Dock-ikon ki van kapcsolva, az ablakot a menüsor-ikonról nyithatja meg." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Táknið í valmyndastikunni verður áfram hvort sem er. Ef slökkt er á Dock-tákninu opnarðu gluggann úr tákninu í valmyndastikunni." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "L’elemento nella barra dei menu resta in ogni caso. Senza l’icona nel Dock, apri la finestra dall’elemento nella barra dei menu." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "どちらの場合もメニューバーの項目は残ります。Dockアイコンをオフにした場合は、メニューバーの項目からウインドウを開いてください。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "메뉴 막대 항목은 어느 경우든 그대로 표시됩니다. Dock 아이콘을 끄면 메뉴 막대 항목에서 윈도우를 여십시오." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Symbolet i menylinjen blir uansett værende. Uten Dock-symbol åpner du vinduet fra symbolet i menylinjen." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Het symbool in de menubalk blijft hoe dan ook staan. Zonder Dock-symbool open je het venster via het symbool in de menubalk." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Symbolet på menylinja blir verande uansett. Når Dock-symbolet er av, opnar du vindauget frå symbolet på menylinja." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Ikona na pasku menu zostaje w obu przypadkach. Gdy ikona w Docku jest wyłączona, otwieraj okno z ikony na pasku menu." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "O item da barra de menus continua lá de qualquer forma. Sem o ícone no Dock, abra a janela pelo item da barra de menus." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "O ícone na barra de menus fica sempre. Sem o ícone na Dock, abra a janela a partir do ícone na barra de menus." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Elementul din bara de meniu rămâne oricum. Cu pictograma din Dock dezactivată, deschideți fereastra din elementul din bara de meniu." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Значок в строке меню остаётся в любом случае. Если значок в Dock выключен, открывайте окно через значок в строке меню." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Položka v lište zostáva v každom prípade. Keď je ikona v Docku vypnutá, otvorte okno z položky v lište." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Ikona v menijski vrstici ostane v vsakem primeru. Če je ikona v vrstici Dock izklopljena, odprite okno prek ikone v menijski vrstici." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Symbolen i menyraden finns kvar i båda fallen. Utan symbol i Dock öppnar du fönstret från menyraden." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "รายการในแถบเมนูจะยังอยู่ไม่ว่าแบบใด เมื่อปิดไอคอนใน Dock ให้เปิดหน้าต่างจากรายการในแถบเมนู" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Menü çubuğu öğesi her durumda kalır. Dock simgesi kapalıyken pencereyi menü çubuğu öğesinden açın." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Значок у рядку меню залишається в будь-якому разі. Якщо значок у Dock вимкнено, відкривайте вікно через значок у рядку меню." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Biểu tượng trên thanh menu luôn được giữ lại. Khi tắt biểu tượng Dock, hãy mở cửa sổ từ biểu tượng trên thanh menu." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "無論如何，選單列項目都會保留。關閉Dock圖像後，可以從選單列項目開啟視窗。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "无论如何，菜单栏项目都会保留。关闭程序坞图标后，请从菜单栏项目打开窗口。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "無論如何，選單列項目都會保留。關閉Dock圖像時，請從選單列項目打開視窗。" }
        }
      }
    },
    "The one you use to log in to this Mac. Patchy passes it straight to macOS and doesn’t keep it." : {
      "comment" : "Sheet message.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The one you use to log in to this Mac. Patchy passes it straight to macOS and doesn’t keep it." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "كلمة السر التي تستخدمها لتسجيل الدخول إلى جهاز Mac هذا. يمرّرها Patchy مباشرة إلى macOS ولا يحتفظ بها." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "La que fas servir per iniciar sessió en aquest Mac. Patchy la passa directament a macOS i no la desa." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Heslo, kterým se přihlašujete k tomuto Macu. Patchy ho předá přímo systému macOS a neukládá si ho." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Den, du bruger til at logge ind på denne Mac. Patchy giver den direkte videre til macOS og gemmer den ikke." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Das Passwort, mit dem du dich an diesem Mac anmeldest. Patchy gibt es direkt an macOS weiter und speichert es nicht." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Αυτό που χρησιμοποιείτε για να συνδέεστε σε αυτό το Mac. Το Patchy το περνά απευθείας στο macOS και δεν το κρατά." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "La que usas para iniciar sesión en este Mac. Patchy se la pasa directamente a macOS y no la guarda." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "همان رمزی که برای ورود به این Mac استفاده می‌کنید. Patchy آن را مستقیماً به macOS می‌دهد و نگه نمی‌دارد." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Salasana, jolla kirjaudut tähän Maciin. Patchy välittää sen suoraan macOS:lle eikä tallenna sitä." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Celui que vous utilisez pour ouvrir une session sur ce Mac. Patchy le transmet directement à macOS et ne le conserve pas." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "הסיסמה שבה משתמשים כדי להתחבר ל-Mac הזה. Patchy מעביר אותה ישירות ל-macOS ולא שומר אותה." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Ona kojom se prijavljujete na ovaj Mac. Patchy je prosljeđuje izravno macOS-u i ne sprema je." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Az a jelszó, amellyel bejelentkezik erre a Macre. A Patchy közvetlenül továbbadja a macOS-nek, és nem tárolja." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Lykilorðið sem þú notar til að skrá þig inn á þennan Mac. Patchy sendir það beint til macOS og geymir það ekki." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Quella che usi per accedere a questo Mac. Patchy la passa direttamente a macOS e non la conserva." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "このMacへのログインに使うパスワードです。PatchyはそれをそのままmacOSに渡し、保存しません。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "이 Mac에 로그인할 때 사용하는 암호입니다. Patchy는 암호를 macOS에 바로 전달하며 보관하지 않습니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Det du bruker for å logge på denne Macen. Patchy sender det rett videre til macOS og tar ikke vare på det." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Het wachtwoord waarmee je inlogt op deze Mac. Patchy geeft het direct door aan macOS en bewaart het niet." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Det du brukar for å logge inn på denne Macen. Patchy sender det rett vidare til macOS og tek ikkje vare på det." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "To hasło, którego używasz do logowania na tym Macu. Patchy przekazuje je prosto do macOS i go nie przechowuje." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "A que você usa para entrar neste Mac. O Patchy a repassa direto para o macOS e não a guarda." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "A que usa para iniciar sessão neste Mac. O Patchy passa-a diretamente ao macOS e não a guarda." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Cea pe care o folosiți ca să vă autentificați pe acest Mac. Patchy o transmite direct către macOS și nu o păstrează." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Тот, с которым вы входите в этот Mac. Patchy передаёт его прямо в macOS и не сохраняет." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Heslo, ktorým sa prihlasujete do tohto Macu. Patchy ho odovzdá priamo systému macOS a neuchováva ho." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Geslo, s katerim se prijavite v ta Mac. Patchy ga posreduje neposredno sistemu macOS in ga ne shrani." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Lösenordet du loggar in på den här Macen med. Patchy skickar det direkt till macOS och sparar det inte." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "รหัสผ่านที่คุณใช้เข้าสู่ระบบ Mac เครื่องนี้ Patchy ส่งรหัสผ่านไปยัง macOS โดยตรงและไม่เก็บไว้" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Bu Mac’te oturum açmak için kullandığınız parola. Patchy onu doğrudan macOS’e iletir ve saklamaz." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Той, яким ви входите на цей Mac. Patchy передає його безпосередньо macOS і не зберігає." }
