        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Només hi ha una versió de PHP instal·lada. En pots afegir d’altres amb Homebrew; apareixeran aquí quan estiguin a punt. Per exemple, al Terminal:" }
