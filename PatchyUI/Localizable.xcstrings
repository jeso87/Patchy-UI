    "Disconnected %@. Some tunnels are still on Cloudflare; you can delete them in the Cloudflare dashboard under Networks › Tunnels." : {
      "comment" : "Banner under the toolbar. The placeholder is a domain like example.com. “Networks › Tunnels” is a place in Cloudflare's dashboard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Disconnected %@. Some tunnels are still on Cloudflare; you can delete them in the Cloudflare dashboard under Networks › Tunnels." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "تم فصل %@. لا تزال بعض الأنفاق على Cloudflare، ويمكنك حذفها من لوحة تحكم Cloudflare ضمن Networks › Tunnels." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "S’ha desconnectat %@. Alguns túnels encara són a Cloudflare; els pots eliminar al tauler de Cloudflare, a Networks › Tunnels." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Doména %@ je odpojená. Některé tunely v Cloudflare zůstaly; smazat je můžete v ovládacím panelu Cloudflare v části Networks › Tunnels." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Forbindelsen til %@ er afbrudt. Nogle tunneller er stadig i Cloudflare; du kan slette dem i Cloudflare-kontrolpanelet under Networks › Tunnels." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ wurde getrennt. Einige Tunnel sind noch bei Cloudflare; du kannst sie im Cloudflare-Dashboard unter Networks › Tunnels löschen." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Το %@ αποσυνδέθηκε. Ορισμένα τούνελ βρίσκονται ακόμα στο Cloudflare· μπορείτε να τα διαγράψετε στον πίνακα ελέγχου του Cloudflare, στην ενότητα Networks › Tunnels." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Se ha desconectado %@. Algunos túneles siguen en Cloudflare; puedes eliminarlos en el panel de Cloudflare, en Networks › Tunnels." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "اتصال %@ قطع شد. برخی تونل‌ها هنوز در Cloudflare هستند؛ می‌توانید آن‌ها را در داشبورد Cloudflare، در بخش Networks › Tunnels حذف کنید." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Verkkotunnus %@ irrotettiin. Osa tunneleista on yhä Cloudflaressa; voit poistaa ne Cloudflaren hallintapaneelista kohdasta Networks › Tunnels." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ a été déconnecté. Certains tunnels sont encore sur Cloudflare ; vous pouvez les supprimer dans le tableau de bord Cloudflare, sous Networks › Tunnels." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "הדומיין %@ נותק. חלק מהמנהרות עדיין נמצאות ב-Cloudflare; אפשר למחוק אותן בלוח הבקרה של Cloudflare תחת Networks › Tunnels." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Domena %@ je odspojena. Neki tuneli još su na Cloudflareu; možete ih izbrisati na nadzornoj ploči Cloudflarea pod Networks › Tunnels." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ leválasztva. Néhány alagút még a Cloudflare-en van; ezeket a Cloudflare irányítópultján, a Networks › Tunnels alatt törölheti." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ var aftengt. Sum göng eru enn í Cloudflare; þú getur eytt þeim í stjórnborði Cloudflare undir Networks › Tunnels." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ è stato scollegato. Alcuni tunnel sono ancora su Cloudflare; puoi eliminarli nella dashboard di Cloudflare, in Networks › Tunnels." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "%@の接続を解除しました。一部のトンネルはCloudflareに残っています。CloudflareダッシュボードのNetworks › Tunnelsで削除できます。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ 연결을 해제했습니다. 일부 터널은 아직 Cloudflare에 남아 있습니다. Cloudflare 대시보드의 Networks › Tunnels에서 삭제할 수 있습니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ er koblet fra. Noen tunneler finnes fortsatt i Cloudflare; du kan slette dem i Cloudflare-kontrollpanelet under Networks › Tunnels." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ is ontkoppeld. Sommige tunnels staan nog in Cloudflare; je kunt ze verwijderen in het Cloudflare-dashboard onder Networks › Tunnels." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ er kopla frå. Nokre tunnelar finst framleis i Cloudflare; du kan slette dei i Cloudflare-kontrollpanelet under Networks › Tunnels." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Odłączono domenę %@. Niektóre tunele nadal są w Cloudflare; możesz je usunąć w panelu Cloudflare w sekcji Networks › Tunnels." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ foi desconectado. Alguns túneis ainda estão no Cloudflare; você pode apagá-los no painel do Cloudflare, em Networks › Tunnels." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ foi desligado. Alguns túneis continuam na Cloudflare; pode eliminá-los no painel da Cloudflare, em Networks › Tunnels." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ a fost deconectat. Unele tuneluri sunt încă în Cloudflare; le puteți șterge din panoul Cloudflare, la Networks › Tunnels." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Домен %@ отключён. Некоторые туннели остались в Cloudflare; их можно удалить в панели Cloudflare в разделе Networks › Tunnels." }
        },
        "sk" : {
