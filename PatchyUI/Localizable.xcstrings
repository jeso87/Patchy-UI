    "Addresses ending in .test only exist on your Mac, so they never clash with real websites." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Addresses ending in .test only exist on your Mac, so they never clash with real websites." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "العناوين التي تنتهي بـ ‎.test موجودة على جهاز Mac فقط، لذا لا تتعارض أبدًا مع المواقع الحقيقية." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Les adreces acabades en .test només existeixen al teu Mac, així que mai no xoquen amb llocs web reals." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Adresy končící na .test existují jen na vašem Macu, takže nikdy nekolidují se skutečnými weby." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Adresser, der ender på .test, findes kun på din Mac, så de kommer aldrig i konflikt med rigtige websteder." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Adressen auf .test gibt es nur auf deinem Mac, sie kommen echten Websites also nie in die Quere." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Οι διευθύνσεις που τελειώνουν σε .test υπάρχουν μόνο στο Mac σας, οπότε δεν συγκρούονται ποτέ με πραγματικούς ιστότοπους." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Las direcciones que acaban en .test solo existen en tu Mac, así que nunca chocan con sitios web reales." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "نشانی‌هایی که به ‎.test ختم می‌شوند فقط روی Mac شما وجود دارند، پس هرگز با سایت‌های واقعی تداخل ندارند." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : ".test-päätteiset osoitteet ovat olemassa vain Macissasi, joten ne eivät koskaan mene sekaisin oikeiden sivustojen kanssa." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Les adresses qui finissent par .test n’existent que sur votre Mac : elles n’entrent donc jamais en conflit avec de vrais sites." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "כתובות שמסתיימות ב-‎.test קיימות רק ב-Mac שלך, ולכן הן אף פעם לא מתנגשות עם אתרים אמיתיים." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Adrese koje završavaju na .test postoje samo na Vašem Macu pa se nikad ne sukobljavaju sa stvarnim web-stranicama." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A .test végű címek csak ezen a Macen léteznek, így sosem ütköznek valódi webhelyekkel." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Vefföng sem enda á .test eru aðeins til á þínum Mac og rekast því aldrei á raunverulega vefi." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Gli indirizzi che finiscono con .test esistono solo sul tuo Mac, quindi non entrano mai in conflitto con i siti reali." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : ".testで終わるアドレスはこのMacの中にしか存在しないため、実在するWebサイトと重なることはありません。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : ".test로 끝나는 주소는 사용자의 Mac에만 존재하므로 실제 사이트와 겹치지 않습니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Adresser som slutter på .test, finnes bare på Macen din, så de kommer aldri i konflikt med ekte nettsteder." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Adressen die op .test eindigen, bestaan alleen op je Mac en zitten echte websites dus nooit in de weg." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Adresser som sluttar på .test, finst berre på Macen din, så dei kolliderer aldri med ekte nettstader." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Adresy kończące się na .test istnieją tylko na twoim Macu, więc nigdy nie kolidują z prawdziwymi witrynami." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Endereços terminados em .test só existem no seu Mac, então nunca entram em conflito com sites reais." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "Os endereços terminados em .test só existem no seu Mac, por isso nunca entram em conflito com sites reais." }
