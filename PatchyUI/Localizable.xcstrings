        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Η υπηρεσία παρασκηνίου που εκτελεί τον διακομιστή δεν αποκρίθηκε. Αν τη σταματήσετε και την ξεκινήσετε ξανά, θα επανέλθει." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "El servicio en segundo plano que hace funcionar el servidor no ha respondido. Si lo detienes y lo vuelves a iniciar, se restablece." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "سرویس پس‌زمینه‌ای که سرور را اجرا می‌کند پاسخ نداد. خاموش و دوباره روشن کردن آن، بازنشانی‌اش می‌کند." }
