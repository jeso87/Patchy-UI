        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy puede actualizar tus direcciones sin preguntar cada vez." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "‏Patchy می‌تواند نشانی‌های شما را به‌روز کند، بی‌آنکه هر بار رمز عبور بپرسد." }
        },
        "fi" : {
