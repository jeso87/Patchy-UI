    "A new password is made each time you share." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "A new password is made each time you share." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "تُنشأ كلمة سر جديدة في كل مرة تشارك فيها." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Cada cop que comparteixes es crea una contrasenya nova." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Při každém sdílení se vytvoří nové heslo." }
        },
        "da" : {
