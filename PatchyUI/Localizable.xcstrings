        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "Enquanto o servidor estiver a funcionar, este Mac mostra a sua cópia local e não consegue chegar ao site real. Todas as outras pessoas continuam a ver o site real." }
