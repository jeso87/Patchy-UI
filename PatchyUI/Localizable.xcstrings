    "Patchy asks for your Mac password on every change." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy asks for your Mac password on every change." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يطلب Patchy كلمة سر Mac عند كل تغيير." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy demana la contrasenya del Mac a cada canvi." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy při každé změně žádá heslo k Macu." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy beder om din Mac-adgangskode ved hver ændring." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy fragt bei jeder Änderung nach deinem Mac-Passwort." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Το Patchy ζητά το συνθηματικό του Mac σας σε κάθε αλλαγή." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy te pide la contraseña del Mac en cada cambio." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "‏Patchy برای هر تغییر، رمز عبور Mac شما را می‌پرسد." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy kysyy Macin salasanaa jokaisen muutoksen yhteydessä." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy demande le mot de passe de votre Mac à chaque modification." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "‏Patchy מבקש את סיסמת ה-Mac שלך בכל שינוי." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy traži Vašu lozinku za Mac pri svakoj promjeni." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A Patchy minden módosításnál kéri a Mac-jelszavát." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy biður um Mac-lykilorðið þitt við hverja breytingu." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy chiede la password del Mac a ogni modifica." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchyは変更のたびにMacのパスワードを求めます。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy가 변경할 때마다 Mac 암호를 묻습니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy ber om Mac-passordet ditt ved hver endring." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy vraagt bij elke wijziging om je Mac-wachtwoord." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy spør etter Mac-passordet ditt ved kvar endring." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy prosi o hasło do Maca przy każdej zmianie." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "O Patchy pede a senha do Mac a cada alteração." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "O Patchy pede a palavra-passe do Mac em cada alteração." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Patchy vă cere parola Mac-ului la fiecare modificare." }
        },
        "ru" : {
