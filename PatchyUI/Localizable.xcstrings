    "If a browser still shows a warning afterwards, quit and reopen it." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "If a browser still shows a warning afterwards, quit and reopen it." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "إذا ظل المتصفح يعرض تحذيرًا بعد ذلك، فأنهِه وافتحه من جديد." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Si després un navegador encara mostra un avís, tanca’l i torna’l a obrir." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Pokud prohlížeč potom stále zobrazuje varování, ukončete ho a znovu otevřete." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Hvis en browser stadig viser en advarsel bagefter, skal du slutte den og åbne den igen." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Wenn ein Browser danach noch eine Warnung zeigt, beende ihn und öffne ihn erneut." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Αν ένα πρόγραμμα περιήγησης εξακολουθεί να δείχνει προειδοποίηση μετά, τερματίστε το και ανοίξτε το ξανά." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Si después un navegador sigue mostrando un aviso, sal de él y vuelve a abrirlo." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "اگر پس از آن مرورگری هنوز هشدار نشان داد، از آن خارج شوید و دوباره بازش کنید." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Jos selain näyttää sen jälkeen yhä varoituksen, lopeta se ja avaa se uudelleen." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Si un navigateur affiche encore un avertissement ensuite, quittez-le et rouvrez-le." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "אם דפדפן עדיין מציג אזהרה אחר כך, יש לסיים אותו ולפתוח אותו מחדש." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Ako preglednik nakon toga i dalje prikazuje upozorenje, zatvorite ga i ponovno otvorite." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Ha egy böngésző ezután is figyelmeztetést mutat, lépjen ki belőle, és nyissa meg újra." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Ef vafri sýnir enn viðvörun á eftir skaltu hætta í honum og opna hann aftur." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Se poi un browser mostra ancora un avviso, chiudilo e riaprilo." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "そのあともブラウザに警告が表示される場合は、ブラウザを終了して開き直してください。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "그 후에도 브라우저에 경고가 표시되면 브라우저를 종료했다가 다시 여십시오." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Hvis en nettleser fortsatt viser en advarsel etterpå, avslutter du den og åpner den igjen." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Toont een browser daarna nog een waarschuwing, stop de browser dan en open hem opnieuw." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Viss ein nettlesar framleis viser ei åtvaring etterpå, avslutt han og opne han på nytt." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Jeśli potem przeglądarka nadal pokazuje ostrzeżenie, zakończ ją i otwórz ponownie." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Se algum navegador ainda mostrar um aviso depois, encerre o navegador e abra-o novamente." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "Se depois um navegador ainda mostrar um aviso, saia dele e volte a abri-lo." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Dacă un browser încă afișează un avertisment după aceea, închideți-l și deschideți-l din nou." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Если после этого браузер всё ещё показывает предупреждение, завершите его и откройте снова." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Ak prehliadač potom stále zobrazuje varovanie, ukončite ho a znova otvorte." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Če brskalnik nato še vedno prikazuje opozorilo, ga zaprite in znova odprite." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Om en webbläsare fortfarande visar en varning efteråt avslutar du den och öppnar den igen." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "หากเบราว์เซอร์ยังแสดงคำเตือนหลังจากนั้น ให้ออกจากเบราว์เซอร์แล้วเปิดใหม่" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Sonrasında bir tarayıcı hâlâ uyarı gösteriyorsa ondan çıkıp yeniden açın." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Якщо після цього браузер досі показує попередження, завершіть його й відкрийте знову." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Nếu sau đó trình duyệt vẫn cảnh báo, hãy thoát rồi mở lại trình duyệt." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "之後如果瀏覽器仍然顯示警告，請結束後重新開啟瀏覽器。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "如果之后浏览器仍显示警告，请退出并重新打开浏览器。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "之後如果瀏覽器仍顯示警告，請結束後再重新打開。" }
        }
      }
    },
