    "macOS asks for your Mac password every time you start or stop the server, or add or remove a site." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS asks for your Mac password every time you start or stop the server, or add or remove a site." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يطلب macOS كلمة سر Mac في كل مرة تشغّل فيها الخادم أو توقفه، أو تضيف موقعًا أو تزيله." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS et demana la contrasenya del Mac cada vegada que inicies o atures el servidor, o afegeixes o elimines un lloc web." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS žádá heslo k Macu pokaždé, když spustíte nebo zastavíte server nebo přidáte či odstraníte web." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS beder om din Mac-adgangskode, hver gang du starter eller stopper serveren eller tilføjer eller fjerner et websted." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS fragt jedes Mal nach deinem Mac-Passwort, wenn du den Server startest oder stoppst oder eine Website hinzufügst oder entfernst." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Το macOS ζητά το συνθηματικό του Mac σας κάθε φορά που ξεκινάτε ή σταματάτε τον διακομιστή ή προσθέτετε ή αφαιρείτε έναν ιστότοπο." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS te pide la contraseña del Mac cada vez que inicias o detienes el servidor, o añades o eliminas un sitio." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "‏macOS هر بار که سرور را روشن یا خاموش می‌کنید یا سایتی را اضافه یا حذف می‌کنید، رمز عبور Mac شما را می‌پرسد." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS kysyy Macin salasanaa aina, kun käynnistät tai pysäytät palvelimen tai lisäät tai poistat sivuston." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS demande le mot de passe de votre Mac chaque fois que vous démarrez ou arrêtez le serveur, ou que vous ajoutez ou retirez un site." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "‏macOS מבקש את סיסמת ה-Mac שלך בכל הפעלה או עצירה של השרת, ובכל הוספה או הסרה של אתר." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS traži Vašu lozinku za Mac svaki put kad pokrenete ili zaustavite poslužitelj ili dodate ili uklonite web-stranicu." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A macOS minden alkalommal kéri a Mac-jelszavát, amikor elindítja vagy leállítja a szervert, illetve hozzáad vagy eltávolít egy webhelyet." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS biður um Mac-lykilorðið þitt í hvert skipti sem þú ræsir eða stöðvar vefþjóninn, eða bætir við eða fjarlægir vef." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS chiede la password del Mac ogni volta che avvii o fermi il server, o aggiungi o rimuovi un sito." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "サーバの起動や停止、サイトの追加や削除のたびに、macOSがMacのパスワードを求めます。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "서버를 시작하거나 중지할 때, 사이트를 추가하거나 제거할 때마다 macOS가 Mac 암호를 묻습니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS ber om Mac-passordet ditt hver gang du starter eller stopper serveren, eller legger til eller fjerner et nettsted." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS vraagt elke keer om je Mac-wachtwoord als je de server start of stopt, of een website toevoegt of verwijdert." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS spør etter Mac-passordet ditt kvar gong du startar eller stoppar serveren, eller legg til eller fjernar ein nettstad." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS prosi o hasło do Maca za każdym razem, gdy uruchamiasz lub zatrzymujesz serwer albo dodajesz lub usuwasz witrynę." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "O macOS pede a senha do Mac toda vez que você inicia ou para o servidor, ou adiciona ou remove um site." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "O macOS pede a palavra-passe do Mac sempre que iniciar ou parar o servidor, ou adicionar ou remover um site." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS vă cere parola Mac-ului de fiecare dată când porniți sau opriți serverul ori adăugați sau eliminați un site." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS запрашивает пароль от Mac каждый раз, когда вы запускаете или останавливаете сервер, добавляете или удаляете сайт." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS si vyžiada heslo k Macu zakaždým, keď spustíte alebo zastavíte server alebo pridáte či odstránite web." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS zahteva vaše geslo za Mac vsakič, ko zaženete ali ustavite strežnik ali dodate ali odstranite spletno mesto." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS ber om ditt Mac-lösenord varje gång du startar eller stoppar servern, eller lägger till eller tar bort en webbplats." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS จะขอรหัสผ่าน Mac ของคุณทุกครั้งที่คุณเริ่มหรือหยุดเซิร์ฟเวอร์ หรือเพิ่มหรือเอาเว็บไซต์ออก" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Sunucuyu her başlattığınızda veya durdurduğunuzda ya da bir site eklediğinizde veya kaldırdığınızda macOS Mac parolanızı ister." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS запитує пароль Mac щоразу, коли ви запускаєте чи зупиняєте сервер або додаєте чи вилучаєте сайт." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "macOS hỏi mật khẩu Mac của bạn mỗi khi bạn khởi động hay dừng máy chủ, hoặc thêm hay gỡ trang web." }
